{
  "metadata": {
    "version": "0.5.1",
    "license": "MIT",
    "authors": [
      {
        "name": "Kinten Le"
      }
    ],
    "description": "Quarkdown grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/kinten108101/tree-sitter-quarkdown"
    }
  },
  "grammars": [
    {
      "name": "quarkdown",
      "scope": "text.quarkdown",
      "path": "tree-sitter-quarkdown",
      "injection-regex": "^(quarkdown|qd)$",
      "file-types": [
        "qd"
      ],
      "highlights": "tree-sitter-quarkdown/queries/highlights.scm",
      "injections": "tree-sitter-quarkdown/queries/injections.scm",
      "external-files": [
        "common/common.js"
      ]
    },
    {
      "name": "quarkdown_inline",
      "camelcase": "QuarkdownInline",
      "scope": "text.quarkdown_inline",
      "path": "tree-sitter-quarkdown-inline",
      "highlights": "tree-sitter-quarkdown-inline/queries/highlights.scm",
      "injections": "tree-sitter-quarkdown-inline/queries/injections.scm",
      "external-files": [
        "common/common.js"
      ]
    }
  ]
}
